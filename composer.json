{
  "name": "jdwx/json-api-client",
  "description": "A simple JSON API client and supporting tools.",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "JDWX\\JsonApiClient\\": "src/"
    }
  },
  "require": {
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0",
    "jdwx/json-php": "^1.0",
    "psr/http-message": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "jdwx/strict": "^1.0",
    "jetbrains/phpstorm-attributes": "^1.0",
    "phan/phan": "^v5",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12"
  },
  "scripts": {
    "phan": "PHAN_ALLOW_XDEBUG=1 php -d xdebug.mode=off vendor/bin/phan --no-progress-bar -S --analyze-twice",
    "phpstan": "phpstan",
    "test": "vendor/bin/phpunit tests"
  }
}
